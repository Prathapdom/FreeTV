<Window x:Class="FreeTV.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FreeTV" Title="Free TV">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#000000" Loaded="OnLoaded">
  <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Background="#000000" Padding="10,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#4F8CFF" CornerRadius="14" Height="46" Margin="0,0,0,28"><TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <Button Grid.Row="1" ToolTipService.ToolTip="Watch" Click="WatchClick" HorizontalAlignment="Stretch" Margin="0,0,0,10"><StackPanel Spacing="4"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/><TextBlock Text="Watch" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
   <Button Grid.Row="2" ToolTipService.ToolTip="Saved favorites" Click="FavoritesClick" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/><TextBlock Text="Saved" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
   <Button Grid.Row="4" ToolTipService.ToolTip="Settings and playlist sources" Click="SettingsClick" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/><TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
  </Grid>
  <Grid Grid.Column="1" Background="#050505" Padding="16,24,16,12" RowSpacing="14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Channels" FontSize="22" FontWeight="SemiBold"/>
   <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Search channels" TextChanged="FilterChanged"/>
   <ComboBox x:Name="Groups" Grid.Row="2" HorizontalAlignment="Stretch" SelectionChanged="GroupChanged" PlaceholderText="All categories"/>
   <TextBlock x:Name="Count" Grid.Row="3" Foreground="#9AA6BB" FontSize="12" Text="Add a playlist in Settings to get started" TextWrapping="Wrap"/>
   <ListView x:Name="ChannelList" Grid.Row="4" SelectionChanged="ChannelSelected" SelectionMode="Single">
    <ListView.ItemTemplate><DataTemplate x:DataType="local:Channel"><Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#263A68" CornerRadius="10" Height="38"><TextBlock Text="{x:Bind Initials}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Group}" Foreground="#9AA6BB" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid></DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <Grid Grid.Column="2" Padding="30,24" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="PageTitle" Text="Watch now" FontSize="24" FontWeight="SemiBold"/><Button Content="Refresh playlist" HorizontalAlignment="Right" Click="RefreshClick"/></Grid>
   <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
   <Grid x:Name="WatchPanel" Grid.Row="2" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="Black" CornerRadius="16"><Grid><MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><TextBlock Text="Your channels. One place." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Open Settings, add a source, then choose a channel." Foreground="#9AA6BB" TextWrapping="Wrap"/><Button Content="Add a playlist source" Click="SettingsClick"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1"><StackPanel Spacing="6"><TextBlock x:Name="PlaybackStatus" Text="READY TO WATCH" Foreground="#56D8EF" FontSize="12"/><TextBlock x:Name="ChannelTitle" Text="Free TV" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ChannelDetails" Text="Live television from your playlists" Foreground="#9AA6BB"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8"><Button x:Name="FavoriteButton" Content="♡ Favorite" Click="FavoriteClick" IsEnabled="False"/><Button Content="Retry" Click="RetryClick"/></StackPanel></Grid>
    <Border Grid.Row="2" Padding="12" Background="#101522" CornerRadius="12"><StackPanel Orientation="Horizontal" Spacing="16"><Button x:Name="FullScreenButton" Content="Full screen" Click="FullScreenClick"/><TextBlock Text="Press Esc to exit full screen." Foreground="#9AA6BB" VerticalAlignment="Center"/></StackPanel></Border>
   </Grid>
   <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"><StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Playlist source" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Add an M3U catalogue to load its channels. Your source and favorites are saved on this computer." Foreground="#9AA6BB" TextWrapping="Wrap"/><TextBox x:Name="SourceUrl" Header="Playlist URL" Text="https://iptv-org.github.io/iptv/index.m3u" MinWidth="400"/><Button x:Name="LoadButton" Content="Save and load channels" Click="LoadClick"/><ProgressBar x:Name="Loading" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="SourceInfo" Foreground="#9AA6BB" TextWrapping="Wrap"/><TextBlock Text="Playback" FontSize="22" Margin="0,20,0,0"/><TextBlock Text="Windows media playback supports HLS and DASH. Some channels may be offline, restricted by region, or require a codec not installed on this PC. Try another channel if playback fails." Foreground="#9AA6BB" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Window>
